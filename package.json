{
	"name": "vahrplan",
	"version": "5.2.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file=.env build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && eslint . --max-warnings 0 --report-unused-disable-directives",
		"lint:fix": "svelte-kit sync && npm run lint -- --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"test": "vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^9.32.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.2.11",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/eslint": "^9.6.1",
		"@types/hafas-client": "^6.3.1",
		"@types/leaflet": "^1.9.15",
		"@types/node": "^25.5.0",
		"@typescript-eslint/eslint-plugin": "^8.19.0",
		"@typescript-eslint/parser": "^8.16.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^27.3.0",
		"leaflet": "^1.9.4",
		"prettier": "^3.5.0",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.8",
		"tslib": "^2.8.1",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.57.2",
		"vite": "^7.3.2",
		"vitest": "^4.1.11"
	},
	"type": "module",
	"dependencies": {
		"@motis-project/motis-fptf-client": "^6.5.2",
		"db-vendo-client": "^6.10.8",
		"hafas-client": "^6.3.6",
		"leaflet": "^1.9.4",
		"redis": "^5.11.0"
	}
}
